-    setTimeout(() => connectSocket(role, onMessage, onStatus), 2000);
+    const next = opened ? 1 : attempt + 1;
+    const delay = Math.min(15000, 1000 * 2 ** (next - 1));
+    setLiveState(false, delay);
+    onStatus(false);
+    setTimeout(() => connectSocket(role, onMessage, onStatus, next), delay);
   };
   return ws;
 }
 
+// Shows a bar over the page while live updates are down, so stale data is never mistaken for current.
+function setLiveState(online, retryMs) {
+  document.body.classList.toggle('is-offline', !online);
+  let bar = document.getElementById('staleBar');
+  if (online) { if (bar) bar.hidden = true; return; }
+  if (!bar) {
+    bar = document.createElement('div');
+    bar.id = 'staleBar';
+    bar.className = 'stale-bar';
+    bar.setAttribute('role', 'status');
+    const host = document.querySelector('.main-container') || document.body;
+    host.prepend(bar);
+  }
+  bar.innerHTML = `${icon('alert')}<span>Live updates paused: connection to the server lost. ` +
+    `Reconnecting in ${Math.round(retryMs / 1000)} s. What is shown may be out of date.</span>`;
+  bar.hidden = false;
+}
