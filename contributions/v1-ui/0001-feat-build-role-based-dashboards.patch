+    try { onMessage(msg); } catch (e) {
+      console.error(`Failed to render ${msg && msg.event}:`, e);
+      notify(`Could not display a live update (${msg && msg.event}). Reload the page if it looks out of date.`, 'warn');
+    }
   };
   ws.onclose = (event) => {
-    onStatus(false);
