+// ---------------------------------------------------------------- plain-language audit explanations
+// Any element with data-explain="<artifact id>" opens a dialog with a Gemini-written summary of that
+// audit record (server: GET /api/audit/{id}/explain). The signed JSON stays the authoritative record.
+function auditButton(artifactId) {
+  return `<button type="button" class="nav-btn explain-btn" data-explain="${escapeHtml(artifactId)}" ` +
+    `title="Explain this record in plain language">${icon('file-text', 'icon-sm')} Explain</button>`;
+}
+
+function renderExplanation(text) {
+  const lines = String(text).split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+  let html = '', list = [];
+  const flush = () => { if (list.length) { html += `<ul>${list.join('')}</ul>`; list = []; } };
+  for (const line of lines) {
+    const bullet = line.match(/^[-*•]\s+(.*)$/);
+    const clean = (s) => escapeHtml(s.replace(/\*\*(.+?)\*\*/g, '$1'));
+    if (bullet) { list.push(`<li>${clean(bullet[1])}</li>`); continue; }
+    flush();
+    html += /^why it matters:/i.test(line)
+      ? `<p class="explain-why">${clean(line)}</p>` : `<p>${clean(line)}</p>`;
+  }
+  flush();
+  return html;
+}
+
+function explainDialog() {
+  let dlg = document.getElementById('explainDialog');
+  if (dlg) return dlg;
+  dlg = document.createElement('dialog');
+  dlg.id = 'explainDialog';
+  dlg.className = 'explain-dialog';
+  dlg.setAttribute('aria-labelledby', 'explainTitle');
+  dlg.innerHTML = `
+    <div class="explain-head">
+      <h2 id="explainTitle">Audit record, in plain language</h2>
+      <button type="button" class="toast-close" data-close aria-label="Close">×</button>
+    </div>
+    <div class="explain-body" id="explainBody" aria-live="polite"></div>
+    <div class="explain-foot" id="explainFoot"></div>`;
+  dlg.addEventListener('click', (e) => {
+    if (e.target === dlg || e.target.closest('[data-close]')) dlg.close();
+  });
+  document.body.appendChild(dlg);
+  return dlg;
+}
+
+async function explainAudit(artifactId) {
+  const dlg = explainDialog();
+  const body = dlg.querySelector('#explainBody');
+  const foot = dlg.querySelector('#explainFoot');
+  const raw = `<a class="nav-btn" href="/api/audit/${encodeURIComponent(artifactId)}" target="_blank">` +
+    `${icon('download', 'icon-sm')} Signed record (${escapeHtml(artifactId)})</a>`;
+  body.setAttribute('aria-busy', 'true');
+  body.innerHTML = `<p class="explain-loading">${icon('loader', 'spin')} Asking Gemini to explain ${escapeHtml(artifactId)}…</p>`;
+  foot.innerHTML = raw;
+  if (!dlg.open) dlg.showModal();
+  try {
+    const { data } = await api(`/api/audit/${encodeURIComponent(artifactId)}/explain`, {}, window.HEDWIG_ROLE || 'admin');
+    body.innerHTML = renderExplanation(data.explanation);
+    foot.innerHTML = `${raw}<span class="check-note">${escapeHtml(data.notice)} Model: ${escapeHtml(data.model)}${data.cached ? ' (cached)' : ''}.</span>`;
+  } catch (err) {
+    body.innerHTML = `<p class="inline-error">${icon('alert', 'icon-sm')} ${escapeHtml(err.message)}</p>` +
+      `<p class="check-note">The signed record below is still available as JSON.</p>`;
+  } finally {
+    body.removeAttribute('aria-busy');
+  }
+}
+
+document.addEventListener('click', (e) => {
+  const el = e.target.closest('[data-explain]');
+  if (!el) return;
+  e.preventDefault();
+  explainAudit(el.dataset.explain);
+});
+
 document.addEventListener('click', async (e) => {
