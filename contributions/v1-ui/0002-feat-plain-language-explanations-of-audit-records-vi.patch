@@ -0,0 +1,131 @@
+"""Plain-language audit explanations (explainer.py + GET /api/audit/{id}/explain). Gemini is mocked."""
+import importlib
+import io
+import json
+import os
+
+import pytest
+from fastapi.testclient import TestClient
+
+
+@pytest.fixture(scope="module")
+def server(tmp_path_factory):
+    d = tmp_path_factory.mktemp("state")
+    os.environ["HEDWIG_BACKEND"] = "statevector"
+    os.environ["HEDWIG_AUDIT_KEY"] = str(d / "audit.pem")
+    os.environ["HEDWIG_DB"] = str(d / "hedwig.db")
+    os.environ["HEDWIG_AUDIT_PQ"] = "off"
+    os.environ.pop("HEDWIG_USERS_FILE", None)
+    import server as srv
+    return importlib.reload(srv)
+
+
+@pytest.fixture()
+def admin(server):
+    c = TestClient(server.app)
+    assert c.post("/api/login", json={"username": "admin", "password": "admin2026"}).status_code == 200
+    return c
+
+
+@pytest.fixture()
+def tx_id(admin):
+    r = admin.post("/api/sign-and-send", json={"message_text": "hello", "n_bits": 16, "threat_type": "authentic"})
+    assert r.status_code == 200
+    return r.json()["transmission"]["transmission_id"]
+
+
+@pytest.fixture()
+def fake_gemini(server, monkeypatch):
+    """Replace the network call; record what would have been sent."""
+    import explainer
+    explainer._cache.clear()
+    calls = []
+
+    def fake(record_text, model, api_key):
+        calls.append({"text": record_text, "model": model, "key": api_key})
+        return "The signature was accepted.\n- Bob and Charlie both checked it.\nWhy it matters: it is genuine."
+
+    monkeypatch.setattr(explainer, "_call_gemini", fake)
+    monkeypatch.setenv("GEMINI_API_KEY", "test-key")
+    monkeypatch.delenv("GEMINI_MODEL", raising=False)
+    return calls
+
+
+def test_without_a_key_the_feature_says_it_is_off(admin, tx_id, monkeypatch):
+    monkeypatch.delenv("GEMINI_API_KEY", raising=False)
+    r = admin.get(f"/api/audit/{tx_id}/explain")
+    assert r.status_code == 503
+    assert "GEMINI_API_KEY" in r.json()["detail"]
+
+
+def test_explains_and_caches(admin, tx_id, fake_gemini):
+    r = admin.get(f"/api/audit/{tx_id}/explain")
+    assert r.status_code == 200
+    body = r.json()
+    assert body["explanation"].startswith("The signature was accepted.")
+    assert body["model"] == "gemini-2.5-flash" and body["cached"] is False
+    assert "authoritative" in body["notice"]
+    again = admin.get(f"/api/audit/{tx_id}/explain").json()
+    assert again["cached"] is True
+    assert len(fake_gemini) == 1, "a record is sent to Gemini at most once"
+    assert fake_gemini[0]["key"] == "test-key"
+
+
+def test_only_the_evidence_stripped_record_is_sent(admin, tx_id, fake_gemini):
+    full = admin.get(f"/api/audit/{tx_id}").json()
+    assert "evidence" in full, "admins can download evidence"
+    admin.get(f"/api/audit/{tx_id}/explain")
+    sent = json.loads(fake_gemini[0]["text"])
+    assert "evidence" not in sent
+    assert sent["record"] == full["record"]
+
+
+def test_model_is_configurable(admin, tx_id, fake_gemini, monkeypatch):
+    monkeypatch.setenv("GEMINI_MODEL", "gemini-custom")
+    assert admin.get(f"/api/audit/{tx_id}/explain").json()["model"] == "gemini-custom"
+
+
+def test_same_access_rules_as_the_record(server, admin, tx_id, fake_gemini):
+    anon = TestClient(server.app)
+    assert anon.get(f"/api/audit/{tx_id}/explain").status_code == 401
+    assert admin.get("/api/audit/TX-DOESNOTEXIST/explain").status_code == 404
+    assert fake_gemini == []
+
+
+def test_gemini_failure_is_a_readable_502(admin, tx_id, monkeypatch):
+    import explainer
+    explainer._cache.clear()
+    monkeypatch.setenv("GEMINI_API_KEY", "test-key")
+
+    def boom(*_):
+        raise explainer.ExplainFailed("Gemini returned HTTP 429: quota exceeded")
+
+    monkeypatch.setattr(explainer, "_call_gemini", boom)
+    r = admin.get(f"/api/audit/{tx_id}/explain")
+    assert r.status_code == 502
+    assert "quota exceeded" in r.json()["detail"]
+
+
+def test_parses_a_gemini_response(monkeypatch):
+    import explainer
+
+    class Resp(io.BytesIO):
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+    sent = {}
+
+    def fake_urlopen(req, timeout):
+        sent["url"], sent["headers"], sent["body"] = req.full_url, dict(req.header_items()), json.loads(req.data)
+        payload = {"candidates": [{"content": {"parts": [{"text": "Plain words."}]}}]}
+        return Resp(json.dumps(payload).encode())
+
+    monkeypatch.setattr(explainer.urllib.request, "urlopen", fake_urlopen)
+    assert explainer._call_gemini("{}", "gemini-x", "k") == "Plain words."
+    assert sent["url"].endswith("/models/gemini-x:generateContent")
+    assert sent["headers"].get("X-goog-api-key") == "k", "key goes in a header, never the URL"
+    assert "?key=" not in sent["url"]
+    assert sent["body"]["systemInstruction"]["parts"][0]["text"].startswith("You explain audit records")
