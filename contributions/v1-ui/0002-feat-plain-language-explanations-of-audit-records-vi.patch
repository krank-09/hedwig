+    """Stored certificate (issued automatically at assessment / quarantine / reset time)."""
+    cert = _readable_audit(artifact_id, session)
     return JSONResponse(cert if evidence and session["role"] == "admin" else strip_evidence(cert),
                         headers={"Content-Disposition": f'attachment; filename="hedwig-audit-{artifact_id}.json"'})
 
 
+@app.get("/api/audit/{artifact_id}/explain")
+async def api_audit_explain(artifact_id: str, session: Dict = Depends(require_any)):
+    """Plain-language explanation of an audit record, generated by Gemini (see explainer.py).
+    Same access rules as the record itself; only the evidence-stripped record is sent."""
+    cert = _readable_audit(artifact_id, session)
+    try:
+        result = await explainer.explain(artifact_id, strip_evidence(cert))
+    except explainer.ExplainUnavailable as e:
+        raise HTTPException(503, str(e))
+    except explainer.ExplainFailed as e:
+        raise HTTPException(502, str(e))
+    return {"artifact_id": artifact_id, "kind": cert["record"].get("kind"), **result,
+            "notice": "Generated by Google Gemini from this audit record. The signed record is authoritative."}
+
+
