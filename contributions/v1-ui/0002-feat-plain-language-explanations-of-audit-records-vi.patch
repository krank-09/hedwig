--- /dev/null
+++ b/explainer.py
@@ -0,0 +1,139 @@
+"""
+Plain-language explanations of audit records, generated by Google Gemini.
+
+The server sends Gemini an audit record with evidence stripped and asks for a short explanation a
+non-specialist can follow. The API key stays on the server:
+
+    GEMINI_API_KEY   required; without it the feature reports itself unavailable (HTTP 503)
+    GEMINI_MODEL     optional; defaults to DEFAULT_MODEL
+
+Records are immutable once issued, so explanations are cached per (artifact id, record digest).
+Uses only the standard library, so no new dependency is needed.
+"""
+import asyncio
+import hashlib
+import json
+import os
+import urllib.error
+import urllib.request
+from collections import OrderedDict
+from typing import Any, Dict
+
+DEFAULT_MODEL = "gemini-2.5-flash"
+ENDPOINT = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
+TIMEOUT_S = 25
+MAX_RECORD_CHARS = 30_000
+CACHE_SIZE = 256
+
+INSTRUCTIONS = """You explain audit records from HEDWIG to people with no background in cryptography
+or quantum physics. HEDWIG is a classical simulation of a quantum digital signature system: Alice
+signs a message, and two verifiers (Bob and Charlie) check it using quantum "tokens". A detector
+looks for eavesdropping or cheating, and a "circuit breaker" can put a link on WATCH or
+QUARANTINE it (block it) until an administrator resets it. Every decision is written as a digitally
+signed record, and records are linked in a hash chain so tampering is detectable.
+
+Useful meanings:
+- transaction record: one signing-and-verification attempt and its outcome.
+- incident record: written when a link was quarantined.
+- link_reset record: an administrator reopened a quarantined link (it goes on probation first).
+- transfer record: a verifier forwarded a signature to another verifier.
+- QBER: the share of test tokens that came out wrong; a high value suggests eavesdropping.
+- mismatches or contradictions: places where the revealed signature contradicts a verifier's own
+  measurements; honest runs have very few.
+- evidence p / p-value: how surprising the evidence would be if nothing were wrong; tiny means
+  "very unlikely to be chance".
+- chain seq / previous hash: the record's position in the tamper-evident chain.
+- signatures (Ed25519, ML-DSA-65): digital signatures that prove the record has not been altered;
+  ML-DSA-65 is a post-quantum algorithm.
+
+Write the explanation:
+1. Start with one plain sentence saying what happened and whether it was good or bad.
+2. Then 3 to 6 short bullet points (start each with "- ") covering who was involved, what was
+   checked, what the system decided, and what happens next.
+3. End with one line starting "Why it matters:".
+
+Rules: use only facts present in the record. Do not invent numbers, names or outcomes. If a field
+is unclear, say so instead of guessing. Avoid jargon; if you must use a term, explain it in a few
+words. Keep it under 180 words. Plain text only, no headings, no code."""
+
+
+class ExplainUnavailable(RuntimeError):
+    """The feature is not configured (no API key)."""
+
+
+class ExplainFailed(RuntimeError):
+    """Gemini could not produce an explanation."""
+
+
+_cache: "OrderedDict[str, Dict[str, Any]]" = OrderedDict()
+
+
+def configured() -> bool:
+    return bool(os.environ.get("GEMINI_API_KEY", "").strip())
+
+
+def _model() -> str:
+    return os.environ.get("GEMINI_MODEL", "").strip() or DEFAULT_MODEL
+
+
+def _record_text(record: Dict[str, Any]) -> str:
+    text = json.dumps(record, indent=1, sort_keys=True, default=str)
+    if len(text) > MAX_RECORD_CHARS:
+        text = text[:MAX_RECORD_CHARS] + "\n… (record truncated for length)"
+    return text
+
+
+def _call_gemini(record_text: str, model: str, api_key: str) -> str:
+    """Blocking HTTPS call; run it in a thread."""
+    body = {
+        "systemInstruction": {"parts": [{"text": INSTRUCTIONS}]},
+        "contents": [{"role": "user", "parts": [{"text": "Explain this audit record:\n\n" + record_text}]}],
+        "generationConfig": {"temperature": 0.2, "maxOutputTokens": 700},
+    }
+    req = urllib.request.Request(
+        ENDPOINT.format(model=model),
+        data=json.dumps(body).encode("utf-8"),
+        headers={"Content-Type": "application/json", "x-goog-api-key": api_key},
+        method="POST",
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
+            payload = json.loads(resp.read().decode("utf-8"))
+    except urllib.error.HTTPError as e:
+        detail = ""
+        try:
+            detail = json.loads(e.read().decode("utf-8")).get("error", {}).get("message", "")
+        except Exception:
+            pass
+        raise ExplainFailed(f"Gemini returned HTTP {e.code}{': ' + detail if detail else ''}") from None
+    except (urllib.error.URLError, TimeoutError) as e:
+        raise ExplainFailed(f"Could not reach Gemini ({getattr(e, 'reason', e)})") from None
+
+    try:
+        parts = payload["candidates"][0]["content"]["parts"]
+        text = "".join(p.get("text", "") for p in parts).strip()
+    except (KeyError, IndexError, TypeError):
+        text = ""
+    if not text:
+        reason = (payload.get("promptFeedback") or {}).get("blockReason") or "empty response"
+        raise ExplainFailed(f"Gemini gave no explanation ({reason})")
+    return text
+
+
+async def explain(artifact_id: str, record: Dict[str, Any]) -> Dict[str, Any]:
+    """Return {"explanation", "model", "cached"} for an (already access-checked) audit record."""
+    api_key = os.environ.get("GEMINI_API_KEY", "").strip()
+    if not api_key:
+        raise ExplainUnavailable("Plain-language explanations are off: set GEMINI_API_KEY on the server.")
+    model = _model()
+    text = _record_text(record)
+    key = f"{artifact_id}|{model}|{hashlib.sha256(text.encode('utf-8')).hexdigest()}"
+    if key in _cache:
+        _cache.move_to_end(key)
+        return {**_cache[key], "cached": True}
+    explanation = await asyncio.to_thread(_call_gemini, text, model, api_key)
+    result = {"explanation": explanation, "model": model}
+    _cache[key] = result
+    while len(_cache) > CACHE_SIZE:
+        _cache.popitem(last=False)
+    return {**result, "cached": False}
