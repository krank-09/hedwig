+        "contents": [{"role": "user", "parts": [{"text": "FACTS:\n" + facts_text}]}],
         "generationConfig": _generation_config(model),
     }
     req = urllib.request.Request(
@@ -169,11 +328,13 @@ def _call_gemini(record_text: str, model: str, api_key: str) -> str:
     return text
 
 
-async def explain(artifact_id: str, record: Dict[str, Any]) -> Dict[str, Any]:
-    """Return {"explanation", "model", "saved_at", "cached"} for an (already access-checked) record."""
+async def explain(artifact_id: str, cert: Dict[str, Any], include_evidence: bool = False) -> Dict[str, Any]:
+    """Return {"explanation", "model", "saved_at", "cached"} for an (already access-checked) certificate.
+    include_evidence: the caller may read this record's evidence (admin)."""
     model = _model()
-    text = _record_text(record)
-    key = f"{artifact_id}|{model}|{hashlib.sha256(text.encode('utf-8')).hexdigest()}"
+    text = _facts_text(facts(cert, include_evidence))
+    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+    key = f"{artifact_id}|{model}|p{PROMPT_VERSION}|{digest}"
     with _lock:
         hit = _load().get(key)
     if hit:
