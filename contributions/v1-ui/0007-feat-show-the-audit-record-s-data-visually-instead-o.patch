 static/js/audit-visuals.js | 344 ++++++++++++++++++++++---------------
 templates/bob.html         |   2 +-
 templates/charlie.html     |   2 +-
 tests/test_explainer.py    |  12 +-
 5 files changed, 245 insertions(+), 147 deletions(-)

